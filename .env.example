DATABASE_URL=postgres://user:password@host:5432/vd_barrisol
# Optional aliases used by some Neon/Vercel integrations. DATABASE_URL remains preferred.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
PAYLOAD_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000

DIGI_STORAGE_EMAIL=digi-account-email@example.com
DIGI_STORAGE_PASSWORD=digi-account-password
DIGI_STORAGE_MOUNT_ID=optional-digi-mount-id
DIGI_STORAGE_API_URL=https://storage.rcs-rds.ro/api/v2.1
DIGI_STORAGE_BASE_PATH=vd-barrisol/images
DIGI_IMAGE_MAX_BYTES=26214400

CONTACT_FROM_EMAIL=VD BARRISOL <noreply@vdbarrisol.ro>
CONTACT_TO_EMAIL=office@vdbarrisol.ro
RESEND_API_KEY=

POSTGRES_CONNECT_TIMEOUT_MS=7000
PUBLIC_DATA_TIMEOUT_MS=8000

# Production defaults to CMS-only prices and published content.
VDB_CONTENT_MODE=live
VDB_PUBLIC_INDEXING=0
VDB_ANALYTICS=0
# Migrations run explicitly using `npm run payload migrate`, not during web requests.
PAYLOAD_RUN_MIGRATIONS=0
